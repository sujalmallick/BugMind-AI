# ── PostgreSQL Database ────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bugmind

# ── JWT Authentication ─────────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_change_me_in_production_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI Provider Keys (Optional Default Fallbacks) ──────────────────────────────
# Users can also configure their own keys via the BYOK settings page in the UI.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# ── Frontend Configuration ─────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── LangSmith Tracing & Observability (Optional) ───────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=bugmind-production
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

