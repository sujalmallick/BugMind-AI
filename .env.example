# Database configuration
# Priority 1: Full DATABASE_URL string (recommended for Azure)
DATABASE_URL=postgresql://user:password@host.postgres.database.azure.com:5432/bugmind

# Priority 2: Individual variables (fallback for local dev)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bugmind
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Auth & Encryption Secrets
SECRET_KEY=generate_with_openssl_rand_hex_32
ENCRYPTION_KEY=generate_with_fernet_generate_key

# CORS & Domain Configuration
ALLOWED_ORIGINS=http://localhost:5173,https://bugmind-frontend.azurestaticapps.net
FRONTEND_URL=https://bugmind-frontend.azurestaticapps.net

# AI Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
FREELLMAPI_API_KEY=your_optional_freellmapi_key_here

# Azure Services Configuration
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_STORAGE_CONTAINER=avatars
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://bugmind-comms.communication.azure.com/;accesskey=...