# Database configuration
# Priority 1: Full DATABASE_URL string (recommended for Azure)
DATABASE_URL=postgresql://user:password@host.postgres.database.azure.com:5432/bugmind

# Priority 2: Individual variables (fallback for local dev)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bugmind
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Auth & Encryption Secrets
SECRET_KEY=generate_with_openssl_rand_hex_32
# Comma-separated to rotate: first key encrypts, all keys decrypt
ENCRYPTION_KEY=generate_with_fernet_generate_key

# CORS & Domain Configuration
ALLOWED_ORIGINS=http://localhost:5173,https://bugmind-frontend.azurestaticapps.net
FRONTEND_URL=https://bugmind-frontend.azurestaticapps.net

# AI Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
FREELLMAPI_API_KEY=your_optional_freellmapi_key_here

# Azure Services Configuration
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_STORAGE_CONTAINER=avatars
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://bugmind-comms.communication.azure.com/;accesskey=...

# AI Guardrails (all default to the secure setting; values shown are defaults)
GUARDRAILS_ENABLED=true
PII_MASKING_ENABLED=true
PROMPT_INJECTION_CHECK_ENABLED=true
OUTPUT_GUARDRAILS_ENABLED=true
TOOL_GUARDRAILS_ENABLED=true
LOG_REDACTION_ENABLED=true
TRACE_REDACTION_ENABLED=true
GUARDRAIL_AUDIT_LOG_ENABLED=true
FAIL_CLOSED_ON_GUARDRAIL_ERROR=true
PROMPT_INJECTION_BLOCK_THRESHOLD=0.8
PROMPT_INJECTION_FLAG_THRESHOLD=0.45
# typed → [EMAIL_REDACTED]; indexed → [EMAIL_1] (still irreversible)
PII_MASK_STYLE=typed
PII_MIN_DETECTION_SCORE=0.5
# Comma-separated PII entities to leave unmasked, e.g. PERSON,ADDRESS (secrets can't be disabled)
PII_DISABLED_ENTITIES=
OUTPUT_PII_REDACTION_ENABLED=true
# Redact synthetic "password: X" test data in generated test cases
OUTPUT_REDACT_TEST_CREDENTIALS=false
PII_SAFE_EMAIL_DOMAINS=example.com,example.org,example.net
GUARDRAIL_MAX_INPUT_CHARS=50000
TOOL_CONFIRMATION_TTL_SECONDS=300
# HMAC key for tool confirmation tokens (falls back to SECRET_KEY)
GUARDRAILS_CONFIRMATION_SECRET=

# Security
# "development" enables /docs, /openapi.json and the test-notification endpoint. Anything else (or unset) = production.
ENVIRONMENT=development
# Set to true behind Azure App Service so rate limits key on the real client IP (right-most X-Forwarded-For hop).
RATE_LIMIT_TRUST_PROXY_HEADERS=false
# Hard cap on request bodies, counted as they stream in (chunked uploads included).
MAX_REQUEST_BODY_BYTES=5242880
